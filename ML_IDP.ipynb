# ============================================
# STEP 8: PREDICTION FUNCTION
# ============================================

def predict_ensemble(area, crop, year, rainfall, pesticide, temperature, model_type='best'):
    """
    Predict crop yield using ensemble models

    Parameters:
    model_type: 'rf', 'ada', 'hybrid', 'voting', 'best'
    """

    # Encode inputs
    area_encoded = label_encoders['Area'].transform([area])[0]
    crop_encoded = label_encoders['Item'].transform([crop])[0]

    # Create features
    rainfall_temp_interaction = rainfall * temperature
    pesticide_per_rainfall = pesticide / (rainfall + 1)

    features = np.array([[
        rainfall, pesticide, temperature, year,
        area_encoded, crop_encoded,
        rainfall_temp_interaction, pesticide_per_rainfall
    ]])

    features_scaled = scaler.transform(features)

    if model_type == 'rf':
        pred = trained_models['Random Forest'].predict(features_scaled)[0]
    elif model_type == 'ada':
        pred = trained_models['AdaBoost'].predict(features_scaled)[0]
    elif model_type == 'hybrid':
        pred = best_hybrid_model.predict(features_scaled)[0]
    elif model_type == 'voting':
        pred = best_voting_model.predict(features_scaled)[0]
    else:  # best
        pred = best_voting_model.predict(features_scaled)[0]

    return pred

